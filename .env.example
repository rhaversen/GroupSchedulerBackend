# Environment. "production"/"staging" connect to real Mongo and require
# DB_* below. "development"/"test" skip the database entirely.
NODE_ENV=development

# Session signing secret. Required in all environments.
SESSION_SECRET=

# Sentry error tracking. Optional; unset disables Sentry.
SENTRY_DSN=

# BetterStack log ingestion token. Required when NODE_ENV=production or
# staging. Unused in development/test.
BETTERSTACK_LOG_TOKEN=

# Per-source ingestion host from the Better Stack dashboard (e.g.
# s762702.eu-central-1a.betterstackdata.com). Optional: omit to use the
# client default (in.logs.betterstack.com).
BETTERSTACK_INGESTING_HOST=

# --- Database (required only when NODE_ENV=production or staging) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
